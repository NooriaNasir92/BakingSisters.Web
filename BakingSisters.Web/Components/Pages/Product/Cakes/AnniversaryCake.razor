@page "/cakes/anniversary-cake"
<div class="container mt-5 mb-5 wedding-cake-container">
    <h2 class="text-center mb-4">Anniversary Cakes</h2>
    <p class="text-center mb-5">Celebrate your special day with our exquisite Anniversary cakes, designed to make your celebration unforgettable.</p>

    <div class="row">
        <!-- First Wedding Cake -->
        <div class="col-md-3 mb-4">
            <div class="card h-100">
                <div class="img-container">
                    <img src="assets/img/anniversary-cake/anniversary-cake-1.jpeg" class="card-img-top" alt="Wedding Cake" loading="lazy" onerror="this.src='assets/img/cake-placeholder.jpg'">
                </div>
                <div class="card-body">
                    <h5 class="card-title">Classic Elegance</h5>
                    <p class="card-text">A timeless multi-tiered wedding cake with delicate floral decorations.</p>
                    <div class="d-flex justify-content-between">
                        <a href="#" class="btn btn-primary">Details</a>
                        <a href="#" class="btn btn-success">Add to Cart</a>
                    </div>
                </div>
            </div>
        </div>

