                </div>
                <div class="card-body">
                    <h5 class="card-title">Classic Elegance</h5>
                    <p class="card-text">A timeless multi-tiered wedding cake with delicate floral decorations.</p>
                    <div class="d-flex justify-content-between">
                        <a href="/product/@birthdayCakes[0].Id" class="btn btn-primary">Details</a>
                        <button @onclick="() => AddToCart(birthdayCakes[0])" class="btn btn-success">Add to Cart</button>
                    </div>
                </div>
            </div>
        </div>

