@page "/cart"
@using BakingSisters.Web.Models
@using BakingSisters.Web.Services
@inject ICartService CartService
@inject NavigationManager NavigationManager
@implements IDisposable
@rendermode InteractiveServer

<h2 class="cart-title">Shopping Cart</h2>

@if (ShoppingCart.IsEmpty)
{
    <div class="empty-cart">
        <i class="fa fa-shopping-cart empty-cart-icon"></i>
        <h3>Your cart is empty</h3>
        <p>Looks like you haven't added any items to your cart yet.</p>
        <button class="start-shopping-btn" @onclick="NavigateToShop">Start Shopping</button>
    </div>
}
else
{
    <div class="cart-page">
        <div class="cart-items">
            @foreach (var item in ShoppingCart.Items)
            {
                <div class="cart-item">
                    <div class="item-image">
                        <img src="@item.ImageUrl" alt="@item.Name" />
                    </div>
                    <div class="item-details">
                        <h3>@item.Name</h3>
                        <p class="item-price">$@item.Price.ToString("0.00")</p>
                        
                        @if (item.Customizations.Any())
                        {
                            <div class="item-customizations">
                                @foreach (var customization in item.Customizations)
                                {
                                    <span class="customization">
                                        @customization.GroupName: @customization.OptionName 
                                        @if (customization.AdditionalPrice > 0)
                                        {
                                            <span class="customization-price">(+$@customization.AdditionalPrice.ToString("0.00"))</span>
                                        }
                                    </span>
                                }
                            </div>
                        }
                    </div>
                    <div class="item-actions">
                        <div class="quantity-selector">
                            <button @onclick="() => UpdateQuantity(item.Id, item.Quantity - 1)">-</button>
                            <span>@item.Quantity</span>
                            <button @onclick="() => UpdateQuantity(item.Id, item.Quantity + 1)">+</button>
                        </div>
                        <p class="item-total">$@item.TotalPrice.ToString("0.00")</p>
                        <button class="remove-btn" @onclick="() => RemoveItem(item.Id)">
                            <i class="fa fa-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
        
        <div class="cart-summary">
            <h3>Order Summary</h3>
            <div class="summary-item">
                <span>Subtotal</span>
                <span>$@ShoppingCart.SubTotal.ToString("0.00")</span>
            </div>
            
            @if (ShoppingCart.CustomizationsTotal > 0)
            {
                <div class="summary-item">
                    <span>Customizations</span>
                    <span>$@ShoppingCart.CustomizationsTotal.ToString("0.00")</span>
                </div>
            }
            
            <div class="summary-total">
                <span>Total</span>
                <span>$@ShoppingCart.Total.ToString("0.00")</span>
            </div>
            
            <button class="checkout-btn" @onclick="Checkout">Proceed to Checkout</button>
            <button class="continue-shopping-btn" @onclick="NavigateToShop">Continue Shopping</button>
            <button class="clear-cart-btn" @onclick="ClearCart">Clear Cart</button>
        </div>
    </div>
}

<style>
    .cart-title {
        text-align: center;
        margin: 2rem 0;
        color: #d4546a;
    }
    
    .cart-page {
        display: flex;
        gap: 2rem;
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem;
    }
    
    .cart-items {
        flex: 3;
    }
    
    .cart-summary {
        flex: 1;
        background-color: #f8f9fa;
        padding: 1.5rem;
        border-radius: 8px;
        position: sticky;
        top: 2rem;
        height: fit-content;
    }
    
    .cart-item {
        display: flex;
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #eee;
    }
    
    .item-image {
        width: 100px;
        height: 100px;
        overflow: hidden;
        border-radius: 8px;
        margin-right: 1rem;
    }
    
    .item-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .item-details {
        flex: 2;
    }
    
    .item-actions {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        justify-content: space-between;
    }
    
    .quantity-selector {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .quantity-selector button {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 1px solid #ddd;
        background-color: white;
        cursor: pointer;
    }
    
    .item-price, .item-total {
        font-weight: bold;
        color: #d4546a;
    }
    
    .item-customizations {
        margin-top: 0.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    
    .customization {
        background-color: #f0f0f0;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 0.85rem;
    }
    
    .customization-price {
        color: #d4546a;
    }
    
    .remove-btn {
        background: none;
        border: none;
        color: #999;
        cursor: pointer;
        font-size: 1.2rem;
    }
    
    .remove-btn:hover {
        color: #d4546a;
    }
    
    .summary-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.75rem;
    }
    
    .summary-total {
        display: flex;
        justify-content: space-between;
        margin: 1.5rem 0;
        padding-top: 1rem;
        border-top: 1px solid #ddd;
        font-weight: bold;
        font-size: 1.2rem;
    }
    
    .checkout-btn, .continue-shopping-btn, .clear-cart-btn, .start-shopping-btn {
        width: 100%;
        padding: 0.75rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        margin-bottom: 0.75rem;
    }
    
    .checkout-btn {
        background-color: #d4546a;
        color: white;
    }
    
    .continue-shopping-btn {
        background-color: white;
        color: #d4546a;
        border: 1px solid #d4546a;
    }
    
    .clear-cart-btn {
        background-color: #f8f9fa;
        color: #666;
        border: 1px solid #ddd;
    }
    
    .empty-cart {
        text-align: center;
        margin: 4rem auto;
        max-width: 500px;
    }
    
    .empty-cart-icon {
        font-size: 4rem;
        color: #ddd;
        margin-bottom: 1rem;
    }
    
    .start-shopping-btn {
        background-color: #d4546a;
        color: white;
        display: inline-block;
        margin-top: 1rem;
    }
    
    @@media (max-width: 768px) {
        .cart-page {
            flex-direction: column;
        }
        
        .cart-item {
            flex-direction: column;
        }
        
        .item-actions {
            flex-direction: row;
            margin-top: 1rem;
        }
    }
</style>

@code {
    private ShoppingCart ShoppingCart = new();
    
    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
        ShoppingCart = CartService.GetCart();
    }
    
    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }
    
    private void UpdateQuantity(int itemId, int quantity)
    {
        CartService.UpdateQuantity(itemId, quantity);
        ShoppingCart = CartService.GetCart();
    }
    
    private void RemoveItem(int itemId)
    {
        CartService.RemoveFromCart(itemId);
        ShoppingCart = CartService.GetCart();
    }
    
    private void ClearCart()
    {
        CartService.ClearCart();
        ShoppingCart = CartService.GetCart();
    }
    
    private async Task Checkout()
    {
        await CartService.CheckoutAsync();
        ShoppingCart = CartService.GetCart();
        NavigationManager.NavigateTo("/order-success");
    }
    
    private void NavigateToShop()
    {
        NavigationManager.NavigateTo("/shop");
    }
} 