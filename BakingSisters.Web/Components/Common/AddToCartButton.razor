@using BakingSisters.Api.Models
@using BakingSisters.Web.Models
@using BakingSisters.Web.Services
@inject ICartService CartService
@inject IToastService ToastService

<div class="add-to-cart-container">
    @if (ShowQuantity)
    {
        <div class="quantity-selector">
            <button class="quantity-btn" @onclick="DecrementQuantity" disabled="@(Quantity <= 1)">-</button>
            <span class="quantity">@Quantity</span>
            <button class="quantity-btn" @onclick="IncrementQuantity">+</button>
        </div>
    }
    
    <button class="@ButtonClass" @onclick="HandleAddToCart" disabled="@IsDisabled">
        <i class="fa fa-shopping-cart"></i> @ButtonText
    </button>
</div>

<style>
    .add-to-cart-container {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .quantity-selector {
        display: flex;
        align-items: center;
        gap: 5px;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 0 5px;
    }
    
    .quantity {
        display: inline-block;
        text-align: center;
        min-width: 30px;
        padding: 5px;
    }
    
    .quantity-btn {
        background: none;
        border: none;
        font-size: 16px;
        cursor: pointer;
        padding: 5px;
    }
    
    .quantity-btn:disabled {
        color: #ccc;
        cursor: not-allowed;
    }
    
    .add-to-cart-btn {
        background-color: #ff69b4;
        color: white;
        border: none;
        padding: 8px 15px;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.3s;
    }
    
    .add-to-cart-btn:hover {
        background-color: #ff4da6;
    }
    
    .add-to-cart-btn:disabled {
        background-color: #ccc;
        cursor: not-allowed;
    }
</style>

@code {
    [Parameter]
    public BakingSisters.Api.Models.Product Product { get; set; } = default!;
    
    [Parameter]
    public List<CartItemCustomization>? Customizations { get; set; }
    
    [Parameter]
    public bool ShowQuantity { get; set; } = true;
    
    [Parameter]
    public string ButtonText { get; set; } = "Add to Cart";
    
    [Parameter]
    public string ButtonClass { get; set; } = "add-to-cart-btn";
    
    [Parameter]
    public bool IsDisabled { get; set; } = false;
    
    [Parameter]
    public EventCallback OnAddedToCart { get; set; }
    
    private int Quantity { get; set; } = 1;
    
    private void IncrementQuantity()
    {
        Quantity++;
    }
    
    private void DecrementQuantity()
    {
        if (Quantity > 1)
            Quantity--;
    }
    
    private async Task HandleAddToCart()
    {
        if (Product == null)
        {
            ToastService.ShowError("Product not found", "Error");
            return;
        }
        
        // Add the product to cart, with customizations if any
        CartService.AddToCart(Product, Customizations);
        
        // Reset quantity to 1
        Quantity = 1;
        
        // Invoke the callback if provided
        await OnAddedToCart.InvokeAsync();
    }
} 